# Live mode is never a default. These values are only read by an explicitly
# requested, read-only fixture capture and must not be production credentials.
MUSIC_MODE=fixture
MUSIC_FIXTURE_VERSION=1
STRAPI_FIXTURE_URL=http://127.0.0.1:51337
LIVE_STRAPI_URL=
LIVE_STRAPI_READ_ONLY_CREDENTIAL=
DATABASE_URL_TEST=postgresql://music:music@127.0.0.1:55432/music_fixture
SESSION_SECRET=replace-with-32-plus-character-fixture-session-secret
COOKIE_SECRET=replace-with-32-plus-character-fixture-cookie-secret
MUSIC_SIGNING_KEY_CURRENT_ID=fixture-current
MUSIC_SIGNING_KEY_CURRENT_SECRET=replace-with-32-plus-character-current-signing-secret
MUSIC_SIGNING_KEY_PREVIOUS_ID=fixture-previous
MUSIC_SIGNING_KEY_PREVIOUS_SECRET=replace-with-32-plus-character-previous-signing-secret
MUSIC_CONNECT_TIMEOUT_MS=5000
MUSIC_READ_TIMEOUT_MS=10000
MUSIC_CIRCUIT_FAILURE_THRESHOLD=3
MUSIC_RATE_LIMIT_PER_MINUTE=60
MUSIC_PROVISIONING_KILL_SWITCH=true
MUSIC_PROVISIONING_COHORT=disabled
MUSIC_EXPECTED_MIGRATION_ID=versioned-migrations-unavailable-c0
MUSIC_RECONCILIATION_ENABLED=false
MUSIC_RECONCILIATION_MAX_ROWS=0
