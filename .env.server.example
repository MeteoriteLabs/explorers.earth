# =============================================================================
# /opt/app/.env  — Server-side environment file on Hetzner
# =============================================================================
# ⚠️  This file is NEVER committed to git. Create it manually on the server.
# ⚠️  All secrets here are runtime-only (Node.js process.env).
# ⚠️  VITE_ frontend vars are NOT here — they are baked into Docker images
#     at build time via GitHub Secrets → docker build --build-arg.
#
# Copy this file to /opt/app/.env on your Hetzner server and fill in values.
# =============================================================================

# ── Traefik / SSL ─────────────────────────────────────────────────────────────
# Email used for Let's Encrypt certificate registration (important for expiry notices)
ACME_EMAIL=your-email@example.com

# ── Docker Image Versioning ───────────────────────────────────────────────────
# For first manual boot, use 'latest'. CI/CD will override with git SHA.
IMAGE_TAG=latest
# Your GitHub username (lowercase) — used to pull images from GHCR
GITHUB_REPOSITORY_LOWER=your-github-username

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# These credentials are used by both the 'db' service and the 'tunes' service.
# The tunes app connects via: postgresql://${DB_USER}:${DB_PASS}@db:5432/${DB_NAME}
DB_USER=cosmic
DB_PASS=CHANGE_ME_use_a_strong_random_password
DB_NAME=cosmic

# ── Tunes App: Auth & Security ────────────────────────────────────────────────
SESSION_SECRET=CHANGE_ME_64_char_random_string_here
COOKIE_SECRET=CHANGE_ME_another_64_char_random_string

# ── Tunes App: Email (SMTP) ───────────────────────────────────────────────────
# Use either SMTP or AWS SES — not both simultaneously.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@localtunes.earth

# ── AWS SES (alternative email method) ───────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Note: AWS_SES_EMAIL_FROM in dev = EMAIL_FROM in production compose

# ── External APIs ─────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
GEMINI_API_KEY=
CLARITY_PROJECT_ID=

# ── Strapi (explorers.earth Auth) ─────────────────────────────────────────────
STRAPI_URL=http://your-strapi-server:1337
STRAPI_ACCESS_TOKEN=
STRAPI_GRAPHQL_ENDPOINT=http://your-strapi-server:1337/graphql
STRAPI_API_KEY=

# ── Spotify ───────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=https://localtunes.earth/api/auth/spotify/callback

# ── Razorpay (Production Keys ONLY) ──────────────────────────────────────────
RAZORPAY_KEY_ID_PROD=
RAZORPAY_KEY_SECRET_PROD=
RAZORPAY_PLAN_ID_MONTHLY_PROD=
RAZORPAY_PLAN_ID_MONTHLY_PRO_PROD=
RAZORPAY_PLAN_ID_YEARLY_PROD=
RAZORPAY_PLAN_ID_YEARLY_PRO_PROD=
