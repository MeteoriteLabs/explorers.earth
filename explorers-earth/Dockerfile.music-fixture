# Music fixture build: the root context makes the canonical shared publication
# response contract available without duplicating it in the Explorer bundle.
FROM node:22.12-alpine AS builder

WORKDIR /workspace/explorers-earth

ARG VITE_API_URL
ARG VITE_REST_API_URL
ARG VITE_PUBLIC_ACCESS_TOKEN
ARG VITE_CLARITY_PROJECT_ID
ARG VITE_LOCAL_TUNES_API_URL

ENV VITE_API_URL=$VITE_API_URL \
    VITE_REST_API_URL=$VITE_REST_API_URL \
    VITE_PUBLIC_ACCESS_TOKEN=$VITE_PUBLIC_ACCESS_TOKEN \
    VITE_CLARITY_PROJECT_ID=$VITE_CLARITY_PROJECT_ID \
    VITE_LOCAL_TUNES_API_URL=$VITE_LOCAL_TUNES_API_URL

COPY explorers-earth/package.json explorers-earth/package-lock.json ./
RUN npm ci

COPY explorers-earth/ ./
COPY tunes/shared/musicPublicationContract.ts /workspace/tunes/shared/musicPublicationContract.ts
RUN npm run build

FROM nginx:1.27-alpine AS runner

RUN rm /etc/nginx/conf.d/default.conf
COPY explorers-earth/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/explorers-earth/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
