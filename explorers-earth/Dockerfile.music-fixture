# Music fixture build: the root context makes the canonical shared publication
# response contract available without duplicating it in the Explorer bundle.
FROM public.ecr.aws/docker/library/node:22.12-alpine@sha256:51eff88af6dff26f59316b6e356188ffa2c422bd3c3b76f2556a2e7e89d080bd AS builder

WORKDIR /workspace/explorers-earth

ARG VITE_API_URL
ARG VITE_REST_API_URL
ARG VITE_PUBLIC_ACCESS_TOKEN
ARG VITE_CLARITY_PROJECT_ID
ARG VITE_LOCAL_TUNES_API_URL
ARG MUSIC_FIXTURE_BUNDLE_CHECK

ENV VITE_API_URL=$VITE_API_URL \
    VITE_REST_API_URL=$VITE_REST_API_URL \
    VITE_PUBLIC_ACCESS_TOKEN=$VITE_PUBLIC_ACCESS_TOKEN \
    VITE_CLARITY_PROJECT_ID=$VITE_CLARITY_PROJECT_ID \
    VITE_LOCAL_TUNES_API_URL=$VITE_LOCAL_TUNES_API_URL \
    MUSIC_FIXTURE_BUNDLE_CHECK=$MUSIC_FIXTURE_BUNDLE_CHECK

COPY explorers-earth/package.json explorers-earth/package-lock.json ./
RUN npm ci

COPY explorers-earth/ ./
COPY tunes/shared/musicPublicationContract.ts /workspace/tunes/shared/musicPublicationContract.ts
COPY tunes/shared/explorersContract.ts /workspace/tunes/shared/explorersContract.ts
COPY tunes/shared/explorersOwnerContentContract.ts /workspace/tunes/shared/explorersOwnerContentContract.ts
RUN npm run build

FROM public.ecr.aws/docker/library/nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS runner

RUN rm /etc/nginx/conf.d/default.conf
COPY explorers-earth/nginx.music-fixture.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/explorers-earth/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
