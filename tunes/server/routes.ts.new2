#!/bin/bash
# This is a temporary script to modify the routes.ts file
# It will replace the SQL query string with a SQL template literal for user_activity inserts

# First make a copy of the original file
cp server/routes.ts server/routes.ts.bak

# Create a sed script to modify the file
cat > /tmp/sed_script.txt << 'EOF'
s/\([ \t]*await db.execute(\n[ \t]*\)`INSERT INTO user_activity (user_id, path, method, created_at) VALUES ([^`]*/\1sql`\n          INSERT INTO user_activity (user_id, path, method, created_at) \n          VALUES (/g
s/\$1, \$2, \$3, \$4)`,[^)]*)/\${userId}, \${path}, \${method}, \${timestamp})`/g
EOF

# Apply the sed script to the file
sed -E -f /tmp/sed_script.txt server/routes.ts > server/routes.ts.new3

# Check if the modification was successful
grep -n "INSERT INTO user_activity" server/routes.ts.new3
